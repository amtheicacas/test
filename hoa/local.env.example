# Copy this file to local.env (same folder), fill in the values, and restart the site. local.env is private and never goes to GitHub.
# Lines starting with # are ignored. No spaces around the = sign, no quotes needed.

# Your own PC only: marks this as a test site (shows detailed errors, uses the local database, skips the live-site safety stops).
# Never set this on the live website.
DJANGO_DEBUG=1

# Zoom (Server-to-Server OAuth app): lets the app create the hearing's Zoom meeting
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
# How the meetings are set up (these are the defaults):
# ZOOM_AUTO_RECORDING=cloud
# ZOOM_ALTERNATIVE_HOSTS=second.host@example.org,third.host@example.org
# ZOOM_HOST_VIDEO=1
# ZOOM_PARTICIPANT_VIDEO=1
# ZOOM_WAITING_ROOM=1

# Email (when you are ready): the service that sends notices
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Letterhead / mailing
# HOA_ADDRESS_LINE1=
# HOA_PHONE=
# ATTORNEY_EMAIL=

# --- Private file storage (photos, saved letters, minutes, site-visit photos). Leave all of these blank to keep files in the local media folder.
# Use the TEST bucket and its own key while testing; never the live ones. Never share these values in chat.
#STORAGE_BUCKET=
#STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
#STORAGE_REGION=us-west-004
#STORAGE_ACCESS_KEY_ID=
#STORAGE_SECRET_ACCESS_KEY=

# --- Backup copy of the files (Cloudflare R2), written ONLY by `manage.py backup_files`. Use its own key, never the live bucket's.
#BACKUP_BUCKET=
#BACKUP_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
#BACKUP_REGION=auto
#BACKUP_ACCESS_KEY_ID=
#BACKUP_SECRET_ACCESS_KEY=
#BACKUP_HEARTBEAT_URL=

# Where the admin pages live (live site: choose something nobody would guess, e.g. board-tools-7k2/). Default: admin/
#ADMIN_URL=

# Email delivery options (defaults are fine for most providers: STARTTLS on port 587, 10 second timeout)
#EMAIL_USE_SSL=1        # use instead of STARTTLS when the provider wants port 465
#EMAIL_TIMEOUT=10
#EMAILLOG_REDACT_LINKS=1   # 0 keeps the private case link in stored email copies
#AI_DAILY_LIMIT=50

# ---- Print service (Lob) ----
# Start with a TEST key (test_...): Lob accepts letters but MAILS NOTHING. A staging site or a copy on a PC refuses a live key; the live site refuses a test key.
# Check the settings without sending anything:  python manage.py check_lob   (add --ping to ask Lob whether it accepts the key)
# MAIL_PROVIDER=lob
# LOB_API_KEY=
# HOA_RETURN_NAME=Heron Landing HOA
# HOA_RETURN_LINE1=
# HOA_RETURN_CITY=Sarasota
# HOA_RETURN_STATE=FL
# HOA_RETURN_ZIP=
